# Copy this file to .env and fill in YOUR OWN values.
# Never upload your real .env file to GitHub.

PORT=3000

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=moviedb

# Email (Gmail address and a Gmail app password)
EMAIL_USER=
EMAIL_PASS=

# Razorpay (test mode keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin dashboard login tokens (any long random text)
JWT_SECRET=

# Redis or Memurai
REDIS_URL=redis://localhost:6379
